-TEST(SaturatingSemaphore, basic_spin_only) {
-  run_basic_test<false>();
-}
-
-TEST(SaturatingSemaphore, basic_may_block) {
-  run_basic_test<true>();
-}
-
-TEST(SaturatingSemaphore, pingpong_spin_only) {
