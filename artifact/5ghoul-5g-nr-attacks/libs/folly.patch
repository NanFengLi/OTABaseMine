-TEST(ThreadCachedInt, SingleThreadedNotCached) {
-  ThreadCachedInt<int64_t> val(0, 0);
-  EXPECT_EQ(0, val.readFast());
-  ++val;
-  EXPECT_EQ(1, val.readFast());
-  for (int i = 0; i < 41; ++i) {
-    val.increment(1);
-  }
-  EXPECT_EQ(42, val.readFast());
-  --val;
-  EXPECT_EQ(41, val.readFast());
