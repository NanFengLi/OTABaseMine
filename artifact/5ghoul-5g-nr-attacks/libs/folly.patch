-    bool res;
-
-    auto fn = [&] {
-      res = !pq_.empty();
-      if (res) {
-        val = pq_.top();
-      } else {
-        setFutex(empty_, 1);
-      }
-    };
-    this->requestFC(fn);
-
-    if (res) {
-      return true;
-    }
-    while (isTrue(empty_)) {
-      if (when == std::chrono::time_point<Clock>::max()) {
-        detail::futexWait(&empty_, 1);
