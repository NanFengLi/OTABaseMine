-TEST(Format, uintToHex) {
-  for (unsigned i = 0; i < (1u << 16) + 2; i++) {
-    compareHex(i);
-  }
-}
-
-TEST(Format, uintToBinary) {
-  for (unsigned i = 0; i < (1u << 16) + 2; i++) {
-    compareBinary(i);
-  }
