-ProcessReturnCode::State ProcessReturnCode::state() const {
-  if (rawStatus_ == RV_NOT_STARTED) {
-    return NOT_STARTED;
-  }
-  if (rawStatus_ == RV_RUNNING) {
-    return RUNNING;
-  }
-  if (WIFEXITED(rawStatus_)) {
-    return EXITED;
-  }
-  if (WIFSIGNALED(rawStatus_)) {
-    return KILLED;
-  }
-  assume_unreachable();
