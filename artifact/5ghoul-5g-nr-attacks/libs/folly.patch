-void ElfFile::reset() noexcept {
-  filepath_[0] = 0;
-
-  if (file_ != MAP_FAILED) {
-    munmap(file_, length_);
-    file_ = static_cast<char*>(MAP_FAILED);
-  }
-
-  if (fd_ != -1) {
-    close(fd_);
-    fd_ = -1;
-  }
