-bool AsyncSocket::removeLifecycleObserver(
-    AsyncTransport::LifecycleObserver* observer) {
-  auto& observers = lifecycleObservers_;
-  auto it = std::find(observers.begin(), observers.end(), observer);
-  if (it == observers.end()) {
-    return false;
-  }
-  observer->observerDetach(this);
-  observers.erase(it);
-  return true;
-}
