-
-  static const Indestructible<AsyncSocketException> ex(
-      AsyncSocketException::END_OF_FILE, "SSL connection closed locally");
-  invokeHandshakeErr(*ex);
-
-  // Close the socket.
-  AsyncSocket::closeNow();
