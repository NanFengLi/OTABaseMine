-template <typename T>
-T& FiberManager::local() {
-  if (std::type_index(typeid(T)) == localType_ && currentFiber_) {
-    return currentFiber_->localData_.get<T>();
-  }
-  return localThread<T>();
-}
-
-template <typename T>
-T& FiberManager::localThread() {
-  static thread_local T t;
-  return t;
-}
