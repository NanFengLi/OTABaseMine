-LineReader::State LineReader::readLine(StringPiece& line) {
-  bol_ = eol_; // Start past what we already returned
-  for (;;) {
-    // Search for newline
-    char* newline = static_cast<char*>(memchr(eol_, '\n', end_ - eol_));
-    if (newline) {
-      eol_ = newline + 1;
