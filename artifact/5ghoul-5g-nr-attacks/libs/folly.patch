-  FOLLY_ALWAYS_INLINE void bulkInsert(
-      InputIt first, InputIt last, bool autoReserve) {
-    if (autoReserve) {
-      auto n = std::distance(first, last);
-      if (n == 0) {
-        return;
-      }
-      table_.reserveForInsert(n);
-    }
-    while (first != last) {
-      insert(*first);
-      ++first;
-    }
-  }
