-            getGlogLevelName(message.getLevel())[0],
-            ltime.tm_mon + 1,
-            ltime.tm_mday,
-            ltime.tm_hour,
-            ltime.tm_min,
-            ltime.tm_sec,
-            usecs.count(),
-            message.getThreadID(),
-            basename,
-            message.getLineNumber(),
-            message.getContextString());
