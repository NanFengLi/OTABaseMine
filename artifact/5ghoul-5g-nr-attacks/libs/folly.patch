-int Subprocess::runChild(
-    const char* executable,
-    char** argv,
-    char** env,
-    const Options& options) const {
-  // Now, finally, exec.
-  if (options.usePath_) {
-    ::execvp(executable, argv);
-  } else {
-    ::execve(executable, argv, env);
-  }
-  return errno;
-}
