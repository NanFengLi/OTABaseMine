-bool IoUringBackend::addTimerFd() {
-  auto* entry = get_sqe();
-  timerEntry_->prepPollAdd(entry, timerFd_, POLLIN, true /*registerFd*/);
-  ++numInternalEvents_;
-  return (1 == submitOne());
