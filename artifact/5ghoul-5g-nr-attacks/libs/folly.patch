-    EXPECT_TRUE(bufB->isShared());
-    bufA->unshare();
-    EXPECT_FALSE(bufA->isShared());
-    EXPECT_FALSE(bufB->isShared());
-
-    if (resetAFirst) {
-      bufA.reset();
-      bufB.reset();
-    } else {
-      bufB.reset();
-      bufA.reset();
-    }
-  };
-  testSwap(true);
-  testSwap(false);
