-template <class Vector>
-std::pair<typename Vector::iterator, string> iterSpotter(Vector& v, int i) {
-  typename Vector::iterator it;
-  string msg;
-
-  switch (i) {
-    case 1:
-      if (!v.empty()) {
-        it = v.begin();
-        ++it;
-        msg = "a[1]";
-        break;
-      }
-      FOLLY_FALLTHROUGH;
-    case 0:
-      it = v.begin();
-      msg = "a.begin";
-      break;
-
-    case 2:
-      if (!v.empty()) {
-        it = v.end();
-        --it;
-        msg = "a[-1]";
-        break;
-      }
-      FOLLY_FALLTHROUGH;
-    case 3:
-      it = v.end();
-      msg = "a.end";
-      break;
-
-    default:
-      cerr << "internal error" << endl;
-      exit(1);
-  }
-
-  return make_pair(it, msg);
-}
