-const ElfShdr* ElfFile::getSectionByIndex(size_t idx) const noexcept {
-  FOLLY_SAFE_CHECK(idx < elfHeader().e_shnum, "invalid section index");
-  return &at<ElfShdr>(elfHeader().e_shoff + idx * sizeof(ElfShdr));
