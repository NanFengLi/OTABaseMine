-    this->requestNoFC(opFn);
-    return res;
-  }
-
-  uint64_t fetchAdd(uint64_t val, Rec* rec = nullptr) {
-    uint64_t res;
-    auto opFn = [&] { res = data_.fetchAdd(val); };
-    this->requestFC(opFn, rec);
-    return res;
-  }
-
- private:
-  Data data_;
-};
