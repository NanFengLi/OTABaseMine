-class Random
-{
-public:
-    inline uint64_t Value()
-    {
-        uint64_t e = m_a - Rot64(m_b, 23);
-        m_a = m_b ^ Rot64(m_c, 16);
-        m_b = m_c + Rot64(m_d, 11);
-        m_c = m_d + e;
-        m_d = e + m_a;
-        return m_d;
-    }
-
-    inline void Init( uint64_t seed)
-    {
-        m_a = 0xdeadbeef;
-        m_b = m_c = m_d = seed;
-        for (int i = 0; i < 20; ++i) {
-          (void)Value();
-        }
-    }
-
-private:
-    static inline uint64_t Rot64(uint64_t x, int k)
-    {
-        return (x << k) | (x >> (64-(k)));
-    }
-
-    uint64_t m_a;
-    uint64_t m_b;
-    uint64_t m_c;
-    uint64_t m_d;
-};
