-inline size_t getAsyncStackTraceFromInitialFrame(
-    folly::AsyncStackFrame* initialFrame,
-    std::uintptr_t* addresses,
-    size_t maxAddresses) {
-  size_t numFrames = 0;
-  for (auto* frame = initialFrame; frame != nullptr && numFrames < maxAddresses;
-       frame = frame->getParentFrame()) {
