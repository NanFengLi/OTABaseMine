-  // It is not meaningful learn whether any instance is at least
-  // as recent as timestamp 0.
-  assert(ts.initialized());
-  if (tid.val >= timestamps_.size()) {
-    return false;
-  }
-  return timestamps_[tid.val].atLeastAsRecentAs(ts);
