-void AsyncSocket::finishFail() {
-  assert(state_ == StateEnum::ERROR);
-  assert(getDestructorGuardCount() > 0);
-
-  AsyncSocketException ex(
-      AsyncSocketException::INTERNAL_ERROR,
-      withAddr("socket closing after error"));
-  invokeAllErrors(ex);
