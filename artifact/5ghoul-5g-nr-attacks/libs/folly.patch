-void AsyncUDPSocket::handlerReady(uint16_t events) noexcept {
-  if (events & (EventHandler::READ | EventHandler::WRITE)) {
-    if (handleErrMessages()) {
-      return;
-    }
-  }
-
-  if (events & EventHandler::READ) {
-    DCHECK(readCallback_);
-    handleRead();
-  }
-}
