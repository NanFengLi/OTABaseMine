-  assert(fiber);
-  auto active = 1 + fibersActive_.fetch_add(1, std::memory_order_relaxed);
-  if (active > maxFibersActiveLastPeriod_) {
-    maxFibersActiveLastPeriod_ = active;
-  }
-  ++fiberId_;
