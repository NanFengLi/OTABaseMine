-      ASSERT_TRUE(maybeByteEvent.has_value());
-      auto& byteEvent = maybeByteEvent.value();
-
-      EXPECT_EQ(ByteEventType::WRITE, byteEvent.type);
-      EXPECT_EQ(expectedOffset, byteEvent.offset);
