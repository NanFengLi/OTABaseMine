-  return
-      *in == '[' ? parseArray(in, map) :
-      *in == '{' ? parseObject(in, map) :
-      *in == '\"' ? parseString(in) :
-      (*in == '-' || (*in >= '0' && *in <= '9')) ? parseNumber(in) :
