-    setAlternateStack(stack_.get(), kAltStackSize);
-  }
-
-  ScopedAlternateSignalStack(ScopedAlternateSignalStack&&) = default;
-  ScopedAlternateSignalStack& operator=(ScopedAlternateSignalStack&&) = default;
