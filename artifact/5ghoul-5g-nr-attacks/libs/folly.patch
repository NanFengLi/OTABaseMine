-template <class String>
-struct StringIdenticalToBM {
-  StringIdenticalToBM() {}
-  void operator()(unsigned int n, size_t len) const {
-    String s;
-    BENCHMARK_SUSPEND { s.append(len, '0'); }
-    FOR_EACH_RANGE (i, 0, n) {
-      String result = to<String>(s);
-      doNotOptimizeAway(result.size());
-    }
-  }
-};
