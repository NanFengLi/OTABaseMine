-std::array<uint64_t, 2> buildExtraAsciiToEscapeBitmap(StringPiece chars) {
-  std::array<uint64_t, 2> escapes{{0, 0}};
-  for (auto b : ByteRange(chars)) {
-    if (b >= 0x20 && b < 0x80) {
-      escapes[b / 64] |= uint64_t(1) << (b % 64);
-    }
-  }
-  return escapes;
-}
