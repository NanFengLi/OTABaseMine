-      const K& key, TValue&& value, bool promote, PruneHookCall pruneHook) {
-    Node* ptr = findInIndex(key);
-    if (ptr) {
-      ptr->pr.second = std::move(value);
-      if (promote) {
-        lru_.splice(lru_.begin(), lru_, lru_.iterator_to(*ptr));
-      }
