-IPAddressV6 IPAddressV6::getSolicitedNodeAddress() const {
-  // Solicited node addresses must be constructed from unicast (or anycast)
-  // addresses
-  DCHECK(!isMulticast());
-
-  uint8_t bytes[16] = {
-      0xff,
-      0x02,
-      0x00,
-      0x00,
-      0x00,
-      0x00,
-      0x00,
-      0x00,
-      0x00,
-      0x00,
-      0x00,
-      0x01,
-      0xff,
-      addr_.bytes_[13],
-      addr_.bytes_[14],
-      addr_.bytes_[15],
-  };
-  return IPAddressV6::fromBinary(ByteRange(bytes, 16));
