-void* huge_page_alloc(void*, size_t size) {
-  if (size < 16 * 4096) {
-    // Arbritrary cutoff: ZSTD_CCtx'es only ever make two kinds of allocations:
-    // 1. one small one for the CCtx itself.
-    // 2. "big" ones for the workspace (ZSTD_cwksp)
