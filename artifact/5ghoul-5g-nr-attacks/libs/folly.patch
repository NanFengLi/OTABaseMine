-void DwarfLineNumberVM::reset() {
-  address_ = 0;
-  file_ = 1;
-  line_ = 1;
-  column_ = 0;
-  isStmt_ = defaultIsStmt_;
-  basicBlock_ = false;
-  endSequence_ = false;
-  prologueEnd_ = false;
-  epilogueBegin_ = false;
-  isa_ = 0;
-  discriminator_ = 0;
