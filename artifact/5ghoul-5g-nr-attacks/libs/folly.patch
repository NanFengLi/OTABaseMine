-void checkRunMode() {
-  if (folly::kIsDebug || folly::kIsSanitize) {
-    std::cerr << "WARNING: Benchmark running "
-              << (folly::kIsDebug ? "in DEBUG mode" : "with SANITIZERS")
-              << std::endl;
-  }
-}
