-void AsyncUDPSocket::dontFragment(bool df) {
-  int optname4 = 0;
-  int optval4 = df ? 0 : 0;
-  int optname6 = 0;
-  int optval6 = df ? 0 : 0;
-#if defined(IP_MTU_DISCOVER) && defined(IP_PMTUDISC_DO) && \
-    defined(IP_PMTUDISC_WANT)
-  optname4 = IP_MTU_DISCOVER;
-  optval4 = df ? IP_PMTUDISC_DO : IP_PMTUDISC_WANT;
