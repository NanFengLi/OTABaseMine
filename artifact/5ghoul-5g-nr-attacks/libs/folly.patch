-void runRandomInsertOrderTest(F&& func) {
-  if (FOLLY_F14_PERTURB_INSERTION_ORDER) {
-    std::string prev;
-    bool diffFound = false;
-    for (int tries = 0; tries < 100; ++tries) {
-      S set;
-      for (char x = '0'; x <= '9'; ++x) {
-        set.emplace(func(x));
-      }
-      std::string s;
-      for (auto&& e : set) {
