-class TestObserver : public folly::ExecutionObserver {
- public:
-  virtual void starting(uintptr_t /* id */) noexcept override {
-    if (nestedStart_ == 0) {
-      nestedStart_ = 1;
-    }
-    numStartingCalled_++;
-  }
-  virtual void stopped(uintptr_t /* id */) noexcept override {
-    nestedStart_--;
-    numStoppedCalled_++;
-  }
-
-  int nestedStart_{0};
-  int numStartingCalled_{0};
-  int numStoppedCalled_{0};
-};
