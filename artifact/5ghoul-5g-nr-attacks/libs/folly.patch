-  using std::chrono::seconds;
-  timespec tp{};
-#ifdef __linux__
-  clockid_t clockid;
-  auto th = const_cast<std::thread&>(handle).native_handle();
-  if (!pthread_getcpuclockid(th, &clockid)) {
