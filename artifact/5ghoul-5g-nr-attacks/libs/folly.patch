-template <typename F>
-invoke_result_t<F> inline runInMainContext(F&& func) {
-  auto fm = FiberManager::getFiberManagerUnsafe();
-  if (UNLIKELY(fm == nullptr)) {
-    return runNoInline(std::forward<F>(func));
-  }
-  return fm->runInMainContext(std::forward<F>(func));
-}
