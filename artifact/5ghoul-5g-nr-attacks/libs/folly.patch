-      auto& atom = *atoms.at(i);
-      auto ebth = std::thread([&] { eb.loopForever(); });
-      eb.waitUntilRunning();
-      eb.runInEventBaseThreadAndWait([&] {
-        size_t x = 0;
-        atom.compare_exchange_weak(
-            x, 1, std::memory_order_release, std::memory_order_relaxed);
-      });
-      size_t x = 0;
-      atom.compare_exchange_weak(
