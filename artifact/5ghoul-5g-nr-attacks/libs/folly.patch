-    rtmEndV.store(rtmEndDisabled, std::memory_order_relaxed);
-    rtmTestV.store(rtmTestDisabled, std::memory_order_relaxed);
-    rtmAbortV.store(rtmAbortDisabled, std::memory_order_relaxed);
-  }
