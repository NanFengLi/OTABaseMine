-        # Note: The offset is specific to linux x86_64.
-        specific_offset = 1296
-        pthread_key_data_addr = gdb.parse_and_eval(
-            f"&(((uintptr_t[2]**)({to_hex(pthread_addr)}+{specific_offset}))"
-            f"[(int){to_hex(tls_key)}/32]"
