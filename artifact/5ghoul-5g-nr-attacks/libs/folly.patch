-template <typename T>
-inline bool TaskIterator<T>::hasCompleted() const {
-  return context_->tasksConsumed < context_->results.size();
-}
-
-template <typename T>
-inline bool TaskIterator<T>::hasPending() const {
-  return !context_.unique();
-}
-
