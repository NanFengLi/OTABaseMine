-template <typename T>
-std::vector<T> divValues() {
-  std::vector<T> rv;
-  for (T i = 1; i < std::numeric_limits<T>::max() && i <= 1000; ++i) {
-    rv.push_back(i);
-    rv.push_back(-i);
-    rv.push_back(std::numeric_limits<T>::max() / i);
-    auto x = std::numeric_limits<T>::min() / i;
-    if (x != 0) {
-      rv.push_back(x);
-    }
-  }
-  return rv;
-}
