-const char* ioUringOpToString(unsigned char op) {
-  switch (op) {
-    X(IORING_OP_NOP);
-    X(IORING_OP_READV);
-    X(IORING_OP_WRITEV);
-    X(IORING_OP_FSYNC);
-    X(IORING_OP_READ_FIXED);
-    X(IORING_OP_WRITE_FIXED);
-    X(IORING_OP_POLL_ADD);
-    X(IORING_OP_POLL_REMOVE);
-    X(IORING_OP_SYNC_FILE_RANGE);
-    X(IORING_OP_SENDMSG);
-    X(IORING_OP_RECVMSG);
-    X(IORING_OP_TIMEOUT);
-  };
-  return "<INVALID op>";
-}
-
-#undef X
