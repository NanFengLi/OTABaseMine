-std::string byteRangeToString(std::string_view data) {
-  std::stringstream res;
-  res << '{';
-  auto f = data.begin();
-  auto l = data.end();
-
-  if (f != l) {
-    res << static_cast<std::int32_t>(*f);
-    while (++f != l) {
-      res << ", " << static_cast<std::int32_t>(*f);
-    }
-  }
-  res << '}';
-  return std::move(res).str();
-}
