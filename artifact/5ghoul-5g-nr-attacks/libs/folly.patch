-auto NestedCommandLineApp::findCommand(const std::string& name) const
-    -> const std::pair<const std::string, CommandInfo>& {
-  auto pos = commands_.find(resolveAlias(name));
-  if (pos == commands_.end()) {
-    throw ProgramExit(
-        1,
-        folly::sformat(
-            "Command '{}' not found. Run '{} {}' for help.",
-            name,
-            programName_,
-            kHelpCommand));
-  }
-  return *pos;
-}
