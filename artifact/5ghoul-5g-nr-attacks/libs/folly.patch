-BENCHMARK(VirtualTaskMethod, iters) {
-  folly::coro::blockingWait([iters]() -> folly::coro::Task<void> {
-    auto base = makeBase(iters);
-    size_t count = 0;
-    for (std::size_t i = 0; i < iters; ++i) {
-      count += co_await base->virtualMethod();
-    }
-    if (count != iters * ((iters % 3) + 1)) {
-      std::terminate();
-    }
-  }());
-}
