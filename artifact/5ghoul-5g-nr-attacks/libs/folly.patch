-    // The output sender for the merge channel.
-    ChannelBridgePtr<MergeChannelEvent<KeyType, ValueType>> sender;
-
-    // A non-owning map from key to receiver.
-    folly::F14NodeMap<KeyType, ChannelBridge<ValueType>*> receiversByKey;
