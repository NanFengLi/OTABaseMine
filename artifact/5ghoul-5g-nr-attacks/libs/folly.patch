-void CheckFirstLessThanSecond(SocketAddress first, SocketAddress second) {
-  EXPECT_TRUE(!(first < first));
-  EXPECT_TRUE(!(second < second));
-  EXPECT_TRUE(first < second);
-  EXPECT_TRUE(!(first == second));
-  EXPECT_TRUE(!(second < first));
-}
