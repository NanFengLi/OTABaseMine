-  auto fm = FiberManager::getFiberManagerUnsafe();
-  if (!fm || !fm->activeFiber_) {
-    mainContextFunc();
-    return waitThread();
-  }
-
-  return waitFiber(*fm, std::forward<F>(mainContextFunc));
