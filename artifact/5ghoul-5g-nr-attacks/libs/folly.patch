-   * if a read error was encountered.
-   *
-   * Example:
-   *   bufSize = 10
-   *   input has "hello world\n"
-   *   The first call returns "hello worl"
-   *   The second call returns "d\n"
-   */
-  State readLine(StringPiece& line);
