-        std::is_constructible_v<
-            folly::Function<folly::coro::Task<bool>(Try<TValue>)>,
-            OnNextFunc>,
-        int> = 0>
-ChannelCallbackHandle consumeChannelWithCallback(
-    TReceiver receiver,
