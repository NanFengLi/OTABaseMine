-uint32_t CreateSeed(int offset, int salt) {
-  uint32_t h = static_cast<uint32_t>(salt & 0xffffffff);
-  h = h * c1;
-  h ^= (h >> 17);
-  h = h * c1;
-  h ^= (h >> 17);
-  h = h * c1;
-  h ^= (h >> 17);
-  h += static_cast<uint32_t>(offset & 0xffffffff);
-  h = h * c1;
-  h ^= (h >> 17);
-  h = h * c1;
-  h ^= (h >> 17);
-  h = h * c1;
-  h ^= (h >> 17);
-  return h;
-}
