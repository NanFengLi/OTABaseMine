-void ThreadPoolExecutor::withAll(FunctionRef<void(ThreadPoolExecutor&)> f) {
-  getSyncVecThreadPoolExecutors().withRLock([f](auto& tpes) {
-    for (auto tpe : tpes) {
-      f(*tpe);
-    }
-  });
-}
