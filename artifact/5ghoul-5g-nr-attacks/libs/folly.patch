-      "V0417 13:45:56.123456 {tid:>5s} rodent.cpp:777]    .   .\n"
-      "V0417 13:45:56.123456 {tid:>5s} rodent.cpp:777]   ( ).( )\n"
-      "V0417 13:45:56.123456 {tid:>5s} rodent.cpp:777]    (o o) .-._.'\n"
-      "V0417 13:45:56.123456 {tid:>5s} rodent.cpp:777]   (  -  )\n"
-      "V0417 13:45:56.123456 {tid:>5s} rodent.cpp:777]    mm mm\n"
-      "V0417 13:45:56.123456 {tid:>5s} rodent.cpp:777] \n"
-      "V0417 13:45:56.123456 {tid:>5s} rodent.cpp:777] =============\n",
-      formatMap);
-  EXPECT_EQ(
-      expected,
-      formatMsg(
-          LogLevel::DBG9,
-          "Eeek, a mouse!\n"
-          "   .   .\n"
-          "  ( ).( )\n"
-          "   (o o) .-._.'\n"
-          "  (  -  )\n"
-          "   mm mm\n"
-          "\n"
-          "=============",
-          "src/rodent.cpp",
-          777,
-          "testFunction"));
-}
