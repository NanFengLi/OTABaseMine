- *  auto receiver1 = fanoutSender.getNewReceiver();
- *  auto receiver2 = fanoutSender.getNewReceiver();
- *  auto receiver3 = fanoutSender.getNewReceiver({1, 2, 3});
- *  std::move(fanoutSender).close();
