-lift_unit_t<async_invocable_inner_type_t<F>> executeOnFiberAndWait(
-    F&& func, folly::EventBase& evb, FiberManager& fm) {
-  DCHECK(!detail::onFiber());
-  return addFiberFuture(std::forward<F>(func), fm).getVia(&evb);
-}
