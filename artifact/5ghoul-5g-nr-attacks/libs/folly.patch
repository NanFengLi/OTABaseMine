-    EXPECT_EQ(i, 12);
-  }
-  swap(junkVec, vec);
-  EXPECT_TRUE(junkVec == somethingVec);
-  EXPECT_EQ(vec.size(), 12);
-  for (auto i : vec) {
-    EXPECT_EQ(i, 12);
-  }
