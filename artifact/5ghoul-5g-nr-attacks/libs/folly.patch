-
-// threadListLock_ is writelocked.
-void EDFThreadPoolExecutor::stopThreads(std::size_t numThreads) {
-  threadsToStop_.fetch_add(numThreads, std::memory_order_relaxed);
-  sem_->post(numThreads);
-}
