-  boost::barrier b{3};
-  for (int i = 0; i < 2; i++) {
-    threads.emplace_back([&, i] {
-      b.wait();
-      rets[i] = q.tryWriteUntil(watch.getCheckpoint() + wait, i);
-    });
-  }
-
-  b.wait();
-  int x;
-  EXPECT_TRUE(q.read(x));
-  EXPECT_EQ(42, x);
-
-  for (int i = 0; i < 2; i++) {
-    threads[i].join();
-  }
-  EXPECT_TRUE(q.read(x));
-
-  for (int i = 0; i < 2; i++) {
-    int other = (i + 1) % 2;
-    if (rets[i]) {
-      EXPECT_EQ(i, x);
-      EXPECT_FALSE(rets[other]);
-    }
-  }
-
-  EXPECT_TRUE(watch.elapsed(wait));
-}
