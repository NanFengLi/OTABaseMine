-  if (size_t(pos) >= range_.size()) {
-    // Note that this branch can execute if pos is negative as well.
-    recordAndPos_.second = off_t(-1);
-    range_.clear();
-  } else {
-    recordAndPos_.second = pos;
-    range_.advance(size_t(pos));
-    advanceToValid();
-  }
