-folly::Range<folly::AsyncBase::Op**> TestUtil::readerWait(
-    folly::AsyncBase* reader) {
-  int fd = reader->pollFd();
-  if (fd == -1) {
-    return reader->wait(1);
-  } else {
-    waitUntilReadable(fd);
-    return reader->pollCompleted();
-  }
-}
