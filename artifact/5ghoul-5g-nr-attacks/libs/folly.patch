-      int offset = (iters * t / num_threads);
-      for (uint32_t i = 0; i < iters / num_threads; i++) {
-        unsigned long k = folly::hash::jenkins_rev_mix32((i + offset));
-        k = k % (iters / num_threads) + offset;
