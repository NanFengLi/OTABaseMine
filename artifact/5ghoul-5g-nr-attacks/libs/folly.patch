-void TestUtil::waitUntilReadable(int fd) {
-  pollfd pfd;
-  pfd.fd = fd;
-  pfd.events = POLLIN;
-
-  int r;
-  do {
-    r = poll(&pfd, 1, -1); // wait forever
-  } while (r == -1 && errno == EINTR);
-  PCHECK(r == 1);
-  CHECK_EQ(pfd.revents, POLLIN); // no errors etc
-}
