-ElfFile::ElfFile(const char* name, Options const& options)
-    : fd_(-1),
-      file_(static_cast<char*>(MAP_FAILED)),
-      length_(0),
-      fileId_(),
-      baseAddress_(0) {
-  open(name, options);
