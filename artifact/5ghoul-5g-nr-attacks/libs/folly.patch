-    }
-    auto fiber = &fibersPool_.front();
-    assert(fiber != nullptr);
-    fibersPool_.pop_front();
-    delete fiber;
-    fibersPoolSize_.store(fibersPoolSize - 1, std::memory_order_relaxed);
-    fibersAllocated_.store(fibersAllocated - 1, std::memory_order_relaxed);
-  }
