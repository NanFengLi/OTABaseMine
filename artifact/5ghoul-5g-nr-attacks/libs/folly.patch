-void AsyncSocket::failWrite(const char* fn, const AsyncSocketException& ex) {
-  VLOG(5) << "AsyncSocket(this=" << this << ", fd=" << fd_
-          << ", state=" << state_ << " host=" << addr_.describe()
-          << "): failed while writing in " << fn << "(): " << ex.what();
