-template <class Operation>
-void parallelRun(
-    Operation op, size_t numThreads = std::thread::hardware_concurrency()) {
-  std::vector<std::thread> threads;
-  for (size_t t = 0; t < numThreads; ++t) {
-    threads.emplace_back([&, t] { op(t); });
-  }
-  for (auto& t : threads) {
-    t.join();
-  }
-}
