-void AsyncUDPSocket::close() {
-  eventBase_->dcheckIsInEventBaseThread();
-
-  if (readCallback_) {
-    auto cob = readCallback_;
-    readCallback_ = nullptr;
-
-    cob->onReadClosed();
-  }
-
-  // Unregister any events we are registered for
-  unregisterHandler();
-
-  if (fd_ != NetworkSocket() && ownership_ == FDOwnership::OWNS) {
-    netops::close(fd_);
-  }
-
-  fd_ = NetworkSocket();
-}
