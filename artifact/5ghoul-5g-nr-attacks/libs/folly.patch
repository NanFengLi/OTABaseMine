-
-  cmt.resetCounters();
-  uf3(cmt);
-  // Max copies: 0. Max copy+moves: 0.
-  EXPECT_LE(cmt.moveCount() + cmt.copyCount(), 0);
-  EXPECT_LE(cmt.copyCount(), 0);
-
-  // pass by rvalue reference
-  Function<size_t(CopyMoveTracker &&)> uf4 = [](CopyMoveTracker&& c) {
-    return c.moveCount();
-  };
-
-  cmt.resetCounters();
-  uf4(std::move(cmt));
-  // Max copies: 0. Max copy+moves: 0.
-  EXPECT_LE(cmt.moveCount() + cmt.copyCount(), 0);
-  EXPECT_LE(cmt.copyCount(), 0);
-}
