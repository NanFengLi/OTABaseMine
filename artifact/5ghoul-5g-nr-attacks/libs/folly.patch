-  EXPECT_TRUE(success);
-
-  // Try modifying value
-  m->find(8)->second = 5309;
-  EXPECT_EQ(m->find(8)->second, 5309);
-
-  // check clear()
-  m->clear();
-  success = true;
-  for (uint64_t i = 0; i < numEntries / 2; i++) {
