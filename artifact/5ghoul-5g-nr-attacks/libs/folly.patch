-    int gso = -1;
-    socklen_t optlen = sizeof(gso);
-    if (!netops::getsockopt(
-            fd_,
-            UDP_GSO_SOCK_OPT_LEVEL,
-            UDP_GSO_SOCK_OPT_TYPE,
-            &gso,
-            &optlen)) {
