-template <bool isURLDecoder, typename Decoder>
-void triggerASANOnBadDecode(std::string_view in, Decoder decoder) {
-  std::vector<char> buf(decodedSize<isURLDecoder>(in));
-  decoder(in.data(), in.data() + in.size(), buf.data());
