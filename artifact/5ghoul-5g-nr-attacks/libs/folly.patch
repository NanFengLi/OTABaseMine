-Expected<std::unique_ptr<int>, Err> f3(int x, double y) {
-  return std::make_unique<int>(int(x + y));
-}
-
-// error result
-Expected<int, Err> f4(int, double, Err err) {
-  return makeUnexpected(err);
-}
-
-// exception
-Expected<int, Err> throws() {
-  throw Exn{};
-}
