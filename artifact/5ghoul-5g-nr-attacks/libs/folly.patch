-  bool hasSenderSet();
-
-  detail::ChannelBridge<ValueType>* getSingleSender();
-
-  folly::F14FastSet<detail::ChannelBridgePtr<ValueType>>* getSenderSet();
-
-  void clearSendersWithClosedReceivers();
