-bool IoUringBackend::addSignalFds() {
-  auto* entry = get_sqe();
-  signalReadEntry_->prepPollAdd(
-      entry, signalFds_.readFd(), POLLIN, false /*registerFd*/);
-  ++numInternalEvents_;
-  return (1 == submitOne());
