-    {1E9, "G"}, // giga
-    {1E6, "M"}, // mega
-    {1E3, "K"}, // kilo
-    {1, ""},
-    {1E-3, "m"}, // milli
-    {1E-6, "u"}, // micro
-    {1E-9, "n"}, // nano
