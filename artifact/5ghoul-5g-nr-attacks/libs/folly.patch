-    class R = typename std::enable_if<
-        !std::is_same<T, U>::value,
-        typename std::common_type<T, U>::type>::type>
-R operator|(const Optional<T>& opt, UnwrapOr<U>&& fallback) {
-  if (const T* p = opt.get_pointer()) {
-    return *p;
-  }
-  return std::move(fallback.value());
