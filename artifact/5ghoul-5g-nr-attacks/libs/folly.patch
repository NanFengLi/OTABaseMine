-
-    def __init__(self):
-        self.name = "fibers-skip-first-frame"
-        self.priority = 100
-        self.enabled = True
-        gdb.frame_filters[self.name] = self
-
-    def filter(self, frames):
-        # skip first frame filter if a fiber is active
-        if FiberUnwinder.get_fiber():
-            next(frames)
-        return frames
