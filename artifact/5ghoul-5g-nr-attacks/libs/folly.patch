-  EXPECT_EQ(moreJunk.size(), 12);
-  for (auto i : moreJunk) {
-    EXPECT_EQ(i, 12);
-  }
-  EXPECT_EQ(vec.size(), 15);
-  for (auto i : vec) {
-    EXPECT_EQ(i, 15);
