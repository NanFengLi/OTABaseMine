-  checkArrayIndex(uint64Num, index);
-  char buf[20];
-  FOR_EACH_RANGE (i, 0, n) {
-    doNotOptimizeAway(u64ToAsciiClassic(uint64Num[index] + (i % 8), buf));
-  }
-}
