-      auto&& expected = std::uint64_t{0};
-
-      for (auto j = 0; !stop.load(std::memory_order_relaxed); ++j) {
-        auto& mutex = mutexes[j % kNumMutexes];
-        auto& barrier = barriers[j % kNumMutexes];
-
