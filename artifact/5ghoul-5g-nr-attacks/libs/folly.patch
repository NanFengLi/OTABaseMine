-template <class F>
-auto makeAsyncTask(folly::Executor::KeepAlive<> ka, F&& func) {
-  return [func = static_cast<F&&>(func),
-          ka = std::move(ka)](auto&& param) mutable {
-    return via(
-        ka,
-        [func = std::move(func),
-         param = static_cast<decltype(param)>(param)]() mutable {
