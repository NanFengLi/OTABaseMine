-   private:
-    struct Compare {
-      bool operator()(const ThreadPtr& ts1, const ThreadPtr& ts2) const {
-        return ts1->id < ts2->id;
-      }
-    };
-    std::vector<ThreadPtr> vec_;
-    // cpu time used by threads that are no longer alive
-    std::chrono::nanoseconds pastCpuUsed_{0};
