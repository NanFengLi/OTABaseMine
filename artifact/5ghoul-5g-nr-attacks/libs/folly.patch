-template <typename F>
-void Baton::waitFiber(FiberManager& fm, F&& mainContextFunc) {
-  FiberWaiter waiter;
-  auto f = [this, &mainContextFunc, &waiter](Fiber& fiber) mutable {
-    waiter.setFiber(fiber);
-    setWaiter(waiter);
-
-    mainContextFunc();
-  };
-
-  fm.awaitFunc_ = std::ref(f);
-  fm.activeFiber_->preempt(Fiber::AWAITING);
