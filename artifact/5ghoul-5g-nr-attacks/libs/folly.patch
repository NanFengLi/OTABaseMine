-template <class F, class G>
-typename std::enable_if<!std::is_same<invoke_result_t<F>, void>::value, void>::
-    type inline callFuncs(F&& f, G&& g, size_t id) {
-  g(id, f());
-}
-
-template <class F, class G>
-typename std::enable_if<std::is_same<invoke_result_t<F>, void>::value, void>::
-    type inline callFuncs(F&& f, G&& g, size_t id) {
-  f();
-  g(id);
-}
-
