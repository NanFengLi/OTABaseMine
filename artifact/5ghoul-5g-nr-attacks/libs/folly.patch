-struct load_fn {
-  template <typename T>
-  T operator()(folly::relaxed_atomic<T> const& obj) const {
-    return obj;
-  }
-  template <typename T>
-  T operator()(folly::Synchronized<T> const& obj) const {
-    return obj.copy();
-  }
-  template <typename T>
-  T operator()(folly::thread_cached_synchronized<T> const& obj) const {
-    return obj;
-  }
-};
-inline constexpr load_fn load{};
