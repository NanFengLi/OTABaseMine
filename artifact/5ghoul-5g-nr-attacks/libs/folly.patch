-      eb.terminateLoopSoon();
-      ebth.join();
-    });
-  }
-  for (size_t i = 0; i < c; ++i) {
-    auto& th = threads.at(i);
-    th.join();
-  }
-  size_t sum = 0;
-  for (auto& atom : atoms) {
-    sum += *atom;
-  }
-  EXPECT_EQ(c, sum);
