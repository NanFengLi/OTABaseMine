- public:
-  enum class Scope {
-    PERMANENT,
-    UNLINK_IMMEDIATELY,
-    UNLINK_ON_DESTRUCTION,
-  };
-  explicit TemporaryFile(
-      StringPiece namePrefix = StringPiece(),
-      fs::path dir = fs::path(),
