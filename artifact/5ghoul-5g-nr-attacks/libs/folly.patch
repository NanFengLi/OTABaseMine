-            }
-            foundAddress = true;
-          }
-        }
-        break;
-      case DW_AT_high_pc:
-        expectedAttributes &= ~kHighPCOrRanges;
-        if (!foundAddress) {
-          if (address >= boost::get<uint64_t>(attr.attrValue)) {
-            return false;
-          }
-          seenHighPC = true;
-          foundAddress = seenLowPC;
-        }
