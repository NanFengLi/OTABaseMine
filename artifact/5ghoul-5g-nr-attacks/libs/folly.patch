-// Correctly chain a SemiFuture for deferral
-template <class T>
-Future<T> chainExecutor(Executor::KeepAlive<> e, SemiFuture<T>&& f) {
-  if (!e) {
-    e = folly::getKeepAliveToken(InlineExecutor::instance());
-  }
-  return std::move(f).via(e);
