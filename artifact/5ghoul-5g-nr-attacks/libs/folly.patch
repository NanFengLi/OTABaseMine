-      T& expected,
-      T desired,
-      std::memory_order /* success */ = std::memory_order_seq_cst,
-      std::memory_order /* failure */ = std::memory_order_seq_cst) {
-    if (value == expected) {
-      value = desired;
-      return true;
-    }
-
-    expected = value;
-    return false;
-  }
-
-  bool compare_exchange_strong(
-      T& expected,
-      T desired,
-      std::memory_order /* success */ = std::memory_order_seq_cst,
