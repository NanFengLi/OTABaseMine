-  // Not one of the signals we know about. Oh well. Reset to default.
-  struct sigaction sa;
-  memset(&sa, 0, sizeof(sa));
-  sa.sa_handler = SIG_DFL;
-  sigaction(signum, &sa, nullptr);
-  raise(signum);
