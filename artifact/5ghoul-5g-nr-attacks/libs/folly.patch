-#ifdef FOLLY_JEMALLOC_NODUMP_ALLOCATOR_CHUNK
-  static chunk_alloc_t* original_alloc_;
-  static void* alloc(
-      void* chunk,
-#else
-  static extent_hooks_t extent_hooks_;
-  static extent_alloc_t* original_alloc_;
-  static void* alloc(
-      extent_hooks_t* extent,
-      void* new_addr,
-#endif
-      size_t size,
-      size_t alignment,
-      bool* zero,
-      bool* commit,
-      unsigned arena_ind);
