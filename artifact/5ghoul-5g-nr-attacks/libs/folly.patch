-namespace {
-
-bool readToString(int fd, std::string& buf, size_t maxSize) {
-  buf.resize(maxSize);
-  char* dest = &buf.front();
-  size_t remaining = maxSize;
-
-  ssize_t n = -1;
-  while (remaining) {
-    n = ::read(fd, dest, remaining);
-    if (n == -1) {
-      if (errno == EINTR) {
-        continue;
-      }
-      if (errno == EAGAIN) {
-        break;
-      }
-      PCHECK("read failed");
-    } else if (n == 0) {
-      break;
-    }
-    dest += n;
-    remaining -= n;
-  }
-
-  buf.resize(dest - buf.data());
-  return (n == 0);
-}
-
