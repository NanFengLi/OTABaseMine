-      [this, &rc](std::queue<std::unique_ptr<AsyncBaseOp>>& freeList) {
-        if (!freeList.empty() && !terminating_) {
-          rc = std::move(freeList.front());
-          freeList.pop();
-          rc->reset();
-        }
-      });
