-void AsyncSocket::destroy() {
-  VLOG(5) << "AsyncSocket::destroy(this=" << this << ", evb=" << eventBase_
-          << ", fd=" << fd_ << ", state=" << state_;
-  // When destroy is called, close the socket immediately
