-  auto it = g_data.find(size);
-  if (it == g_data.end()) {
-    auto ptr = std::make_shared<ConcurrentAccessData>(size);
-    g_data[size] = ptr;
-    return ptr.get();
-  }
-  return it->second.get();
-}
