-  if (!ok) {                                                            \
-    cerr << "expected " << hex << e << " but got " << actual << endl;   \
-    ++errors;                                                           \
-  }                                                                     \
-  assert(ok);                                                           \
-} while (0)
-
-#define IsAlive(x) do { alive += IsNonZero(x); } while (0)
