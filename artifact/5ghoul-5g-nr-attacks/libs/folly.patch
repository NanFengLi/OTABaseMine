-bool isColorfulTty(int options, int fd) {
-  if ((options & SymbolizePrinter::TERSE) != 0 ||
-      (options & SymbolizePrinter::COLOR_IF_TTY) == 0 || fd < 0 ||
-      !::isatty(fd)) {
-    return false;
-  }
-  auto term = ::getenv("TERM");
-  return !(term == nullptr || term[0] == '\0' || strcmp(term, "dumb") == 0);
