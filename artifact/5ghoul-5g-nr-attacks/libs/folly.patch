-        (dynamic)std::numeric_limits<double>::infinity()) :
-      in.consume("NaN") ?
-        (in.getOpts().parse_numbers_as_strings ? (dynamic)"NaN" :
-          (dynamic)std::numeric_limits<double>::quiet_NaN()) :
