-void AsyncServerSocket::bind(
-    const std::vector<IPAddressIfNamePair>& addresses, uint16_t port) {
-  if (addresses.empty()) {
-    throw std::invalid_argument("No ip addresses were provided");
-  }
-  if (eventBase_) {
