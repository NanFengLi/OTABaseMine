-  template <typename Self, typename K>
-  static auto findWithoutPromotionImpl(Self& self, const K& key) {
-    Node* ptr = self.findInIndex(key);
-    return ptr ? self_iterator_t<Self>(self.lru_.iterator_to(*ptr))
-               : self.end();
-  }
