-// Initialize data to pseudorandom values.
-void Setup() {
-  if (completed_self_tests == 0) {
-    uint64_t a = 9;
-    uint64_t b = 777;
-    for (int i = 0; i < kDataSize; i++) {
-      a += b;
-      b += a;
-      a = (a ^ (a >> 41)) * k0;
-      b = (b ^ (b >> 41)) * k0 + i;
-      uint8_t u = b >> 37;
-      memcpy(data + i, &u, 1);  // uint8_t -> char
-    }
-  }
-}
