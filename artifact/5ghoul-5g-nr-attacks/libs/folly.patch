-
-    if (flags & POLLOUT) {
-      ret |= EV_WRITE;
-    }
-
-    if (flags & (POLLERR | POLLHUP)) {
-      ret |= (EV_READ | EV_WRITE);
-    }
-
-    ret &= events;
-
-    return ret;
-  }
