-    AtomicInt count_{0};
-    std::atomic<bool> inUpdate_{false};
-    TLRefCount& refCount_;
-
-    std::mutex collectMutex_;
-    Int collectCount_{0};
-    std::shared_ptr<void> collectGuard_;
