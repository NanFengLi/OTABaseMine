-void IoUringBackend::IoSqeBase::internalCallback(
-    int res, uint32_t flags) noexcept {
-  if (!(flags & IORING_CQE_F_MORE)) {
-    inFlight_ = false;
-  }
-  if (cancelled_) {
-    callbackCancelled();
-  } else {
-    callback(res, flags);
-  }
-}
