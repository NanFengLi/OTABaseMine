-
-    do {
-      size_t cmpLen = std::min(current->length(), expectedLen - offset);
-      CHECK_EQ(cmpLen, current->length());
-      CHECK_EQ(memcmp(current->data(), expected + offset, cmpLen), 0);
-      offset += cmpLen;
