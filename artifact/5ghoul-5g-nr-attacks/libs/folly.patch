-  template <typename CriticalSection>
-  auto lock_combine(CriticalSection func, std::size_t index) {
-    auto value = folly::invoke_result_t<CriticalSection&>{};
-    this->requestFC([&]() { value = func(); }, records_.at(index));
-    return value;
-  }
