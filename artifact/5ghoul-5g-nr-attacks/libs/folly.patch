-  FOLLY_MAYBE_UNUSED void lock(bool read) {
-    if (lockType == LockType::MUTEX) {
-      mutex.lock();
-    } else if (lockType == LockType::SPINLOCK) {
-      spinLock.lock();
-    } else if (lockType == LockType::SHAREDMUTEX) {
