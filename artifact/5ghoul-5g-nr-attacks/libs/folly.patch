-  std::memcpy(c2->writableTail(), c1->data(), c1->length() / 2);
-  c2->append(c1->length() / 2);
-  auto c3 = folly::IOBuf::create(c1->length() - c2->length());
-  std::memcpy(
-      c3->writableTail(),
