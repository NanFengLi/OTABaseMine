-  void deallocate(char* ptr, size_t n) {
-    EXPECT_EQ(1, allocated_.erase(ptr));
-    arena_.get().deallocate(ptr, n);
-  }
-
-  bool isEmpty() const { return allocated_.empty(); }
-
-  std::reference_wrapper<ParentAlloc> arena_;
-  std::set<void*> allocated_;
-};
