-struct B {
-  struct BException : std::exception {};
-
-  /* implicit */ B(int x) : x_(x) {
-    if (ticker-- == 0) {
-      throw BException();
-    }
-    constructB++;
-  }
-  B(const B& o) : x_(o.x_) { constructB++; }
-  ~B() { destroyB++; }
-  int x_;
-};
