-  static constexpr std::size_t kUnlocked = 0;
-  static constexpr std::size_t kExclusiveLockFlag = 1;
-  static constexpr std::size_t kSharedLockCountIncrement = 2;
-
-  folly::Synchronized<State, folly::SpinLock> state_;
-};
