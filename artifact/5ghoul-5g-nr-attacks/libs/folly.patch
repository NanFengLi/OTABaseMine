-    setFromSockaddr(reinterpret_cast<const struct sockaddr_in6*>(address));
-  } else if (address->sa_family == AF_UNIX) {
-    setFromSockaddr(
-        reinterpret_cast<const struct sockaddr_un*>(address), addrlen);
