-const std::string& NestedCommandLineApp::resolveAlias(
-    const std::string& name) const {
-  auto dest = &name;
-  for (;;) {
-    auto pos = aliases_.find(*dest);
-    if (pos == aliases_.end()) {
-      break;
-    }
-    dest = &pos->second;
-  }
-  return *dest;
-}
