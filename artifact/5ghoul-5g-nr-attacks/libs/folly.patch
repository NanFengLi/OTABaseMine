-uint64_t hashIOBuf(const IOBuf* buf) {
-  uint64_t h = folly::hash::fnv64_hash_start;
-  for (auto& range : *buf) {
-    h = folly::hash::fnv64_buf(range.data(), range.size(), h);
-  }
-  return h;
-}
