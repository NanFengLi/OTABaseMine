-    a.blockingRead(val);
-    EXPECT_TRUE(val.empty());
-  }
-  {
-    std::string tmp;
-    EXPECT_FALSE(a.read(tmp));
-  }
-  EXPECT_EQ(0, a.sizeGuess());
-
-  EXPECT_EQ(numValues, results.size());
-  for (size_t i = 0; i < results.size(); ++i) {
