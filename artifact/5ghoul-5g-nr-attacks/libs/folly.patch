-inline void EventBaseLoopController::runEagerFiber(Fiber* fiber) {
-  if (!eventBaseKeepAlive_) {
-    eventBaseKeepAlive_ = getKeepAliveToken(eventBase_);
-  }
-  if (loopRunner_) {
-    loopRunner_->run([&] { fm_->runEagerFiberImpl(fiber); });
