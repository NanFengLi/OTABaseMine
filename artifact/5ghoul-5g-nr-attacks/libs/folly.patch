-  // Golang also requires SA_ONSTACK. See:
-  // https://golang.org/pkg/os/signal/#hdr-Go_programs_that_use_cgo_or_SWIG
-  sa.sa_flags |= SA_SIGINFO | SA_ONSTACK;
-  sa.sa_sigaction = &signalHandler;
