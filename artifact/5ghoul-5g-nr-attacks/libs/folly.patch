-/* Version -> (count of outstanding snapshots, saved setting values) */
-auto& getSavedValues() {
-  static std::unordered_map<
-      SettingCoreBase::Version,
-      std::pair<size_t, std::unordered_map<SettingCoreBase::Key, BoxedValue>>>
-      gSavedValues;
-  return gSavedValues;
