-    if (!needRefresh) {
-      version_ = version;
-      return versionLastChange_;
-    }
-
-    try {
-      VersionedData newData{creator_(), version};
-      if (!newData.data) {
-        throw std::logic_error("Observer creator returned nullptr.");
-      }
-      if (data_.copy().data != newData.data) {
-        data_.swap(newData);
