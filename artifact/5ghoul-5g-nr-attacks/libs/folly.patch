-template <
-    typename Awaitable,
-    std::enable_if_t<
-        folly::Conjunction<
-            detail::_has_free_operator_co_await<Awaitable>,
-            folly::Negation<detail::_has_member_operator_co_await<Awaitable>>>::
-            value,
-        int> = 0>
-decltype(auto) get_awaiter(Awaitable&& awaitable) {
