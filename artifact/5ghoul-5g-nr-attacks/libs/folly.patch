-  WaitableMutex mu;
-  std::thread t([&]() {
-    std::lock_guard<WaitableMutex> g(mu);
-    mu.wait([&]() { return go == true; });
-  });
-  sleep(1);
-
-  {
-    std::lock_guard<WaitableMutex> g(mu);
-    go = true;
-  }
-  t.join();
-}
