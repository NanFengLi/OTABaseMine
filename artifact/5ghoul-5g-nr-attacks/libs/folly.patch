-      .semi()
-      .deferValue([&](auto&&) { k = true; })
-      .via(&x2)
-      .thenValueInline([&](auto&&) { l = true; })
-      .semi()
-      .deferValue([&](auto&&) { m = true; })
-      .via(&x1)
-      .thenValue([&](auto&&) { n = true; })
-      .semi()
-      .deferValue([&](auto&&) { o = true; })
-      .deferValue([&](auto&&) { p = true; })
-      .via(&x1)
