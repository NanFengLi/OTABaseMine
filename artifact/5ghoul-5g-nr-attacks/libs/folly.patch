-  // Swapping two heap vectors.
-  folly::small_vector<int, N> moreJunk(15, 15);
-  EXPECT_EQ(moreJunk.size(), 15);
-  for (auto i : moreJunk) {
-    EXPECT_EQ(i, 15);
-  }
