-void IoUringBackend::IoSqeBase::internalSubmit(
-    struct io_uring_sqe* sqe) noexcept {
-  if (inFlight_) {
-    LOG(ERROR) << "cannot resubmit an IoSqe. type="
-               << folly::demangle(typeid(*this));
-    return;
-  }
-  inFlight_ = true;
-  processSubmit(sqe);
-  ::io_uring_sqe_set_data(sqe, this);
-}
