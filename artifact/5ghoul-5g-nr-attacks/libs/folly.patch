-  /**
-   * Sends the given value to all corresponding receivers.
-   */
-  template <typename U = ValueType>
-  void write(U&& element);
-
-  /**
-   * Closes the fanout sender.
-   */
-  void close(exception_wrapper ex = exception_wrapper()) &&;
