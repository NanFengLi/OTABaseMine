-bz_stream createBzStream() {
-  bz_stream stream;
-  stream.bzalloc = nullptr;
-  stream.bzfree = nullptr;
-  stream.opaque = nullptr;
-  stream.next_in = stream.next_out = nullptr;
-  stream.avail_in = stream.avail_out = 0;
-  return stream;
