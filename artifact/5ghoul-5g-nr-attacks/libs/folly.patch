-void AsyncServerSocket::detachEventBase() {
-  assert(eventBase_ != nullptr);
-  eventBase_->dcheckIsInEventBaseThread();
-  assert(!accepting_);
-
-  eventBase_ = nullptr;
-  for (auto& handler : sockets_) {
-    handler.detachEventBase();
-  }
