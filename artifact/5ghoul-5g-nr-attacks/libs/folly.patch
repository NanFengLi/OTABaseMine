-  }
-  EXPECT_TRUE(success);
-
-  // Check findAt
-  success = true;
-  AHMapT::const_iterator retIt;
-  for (int32_t i = 0; i < int32_t(numEntries); i++) {
-    retIt = m->find(i);
-    retIt = m->findAt(retIt.getIndex());
-    success &= (retIt->second == genVal(i));
