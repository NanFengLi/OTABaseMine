-ThreadPoolExecutor::ThreadPtr ThreadPoolExecutor::StoppedThreadQueue::take() {
-  while (true) {
-    {
-      std::lock_guard<std::mutex> guard(mutex_);
-      if (!queue_.empty()) {
-        auto item = std::move(queue_.front());
-        queue_.pop();
-        return item;
-      }
-    }
-    sem_.wait();
-  }
-}
