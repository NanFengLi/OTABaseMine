-  int i = 0;
-  for (; i < idx; ++i) {
-    ASSERT_EQ(dsa[i], convertToInt(a.data()[i])) << i;
-  }
-  for (; i < idx + n; ++i) {
-    ASSERT_EQ(val, convertToInt(a.data()[i])) << i;
-  }
-  for (; size_t(i) < a.size(); ++i) {
-    ASSERT_EQ(dsa[i - n], convertToInt(a.data()[i])) << i;
-  }
-}
