-    // Wait a while, try again.
-    timespec ts;
-    ts.tv_sec = 0;
-    ts.tv_nsec = 100L * 1000 * 1000; // 100ms
-    nanosleep(&ts, nullptr);
-
-    prevSignalThread = kInvalidThreadId;
-  }
