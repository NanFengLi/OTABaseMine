-      // now read the byte stored in OOB buffer
-      n = recv(fd_, buffer.data(), buffer.size(), MSG_OOB);
-      EXPECT_EQ(1, n);
-    }
-
-   private:
-    int fd_;
-  } sockHandler(&eb, serverFd);
-
-  sockHandler.registerHandler(EventHandler::EventFlags::PRI);
-  LOG(INFO) << "Registered Handler";
