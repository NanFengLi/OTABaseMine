-        folly::Conjunction<
-            is_awaiter<Awaitable>,
-            folly::Negation<detail::_has_free_operator_co_await<Awaitable>>,
-            folly::Negation<detail::_has_member_operator_co_await<Awaitable>>>::
-            value,
-        int> = 0>
