-  }
-  if (counts.moveConvert > 0) {
-    xo << glue << counts.moveConvert << " move convert";
-    glue = ", ";
-  }
-  if (counts.copyAssign > 0) {
-    xo << glue << counts.copyAssign << " copy assign";
-    glue = ", ";
-  }
-  if (counts.moveAssign > 0) {
-    xo << glue << counts.moveAssign << " move assign";
-    glue = ", ";
-  }
