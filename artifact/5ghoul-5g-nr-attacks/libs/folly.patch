-// fastest conceivable hash function (for comparison)
-static void Add(const void *data, size_t length,
-                uint64_t *hash1, uint64_t *hash2)
-{
-    uint64_t *p64 = (uint64_t *)data;
-    uint64_t *end = p64 + length/8;
-    uint64_t hash = *hash1 + *hash2;
-    while (p64 < end)
-    {
-      hash += *p64;
-      ++p64;
-    }
-    *hash1 = hash;
-    *hash2 = hash;
-}
