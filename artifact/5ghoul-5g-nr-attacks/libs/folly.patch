-struct is_awaiter<
-    T,
-    folly::void_t<
-        decltype(std::declval<T&>().await_ready()),
-        decltype(std::declval<T&>().await_resume())>>
-    : std::is_same<bool, decltype(std::declval<T&>().await_ready())> {};
