-  CHECK_LE(size, size_);
-  auto p = hashCache_.find(size);
-  if (p != hashCache_.end()) {
-    return p->second;
-  }
-
-  uint64_t h = folly::hash::fnv64_buf(data_.get(), size);
-  hashCache_[size] = h;
-  return h;
-}
