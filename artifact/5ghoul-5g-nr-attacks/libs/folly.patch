-      {seenEndOfStream, seenEndOfStream, seenError}};
-
-  int totalEventCount = 0;
-
-  auto selectStream = [](int index) -> AsyncGenerator<int> {
-    auto ints = [](int n) -> AsyncGenerator<int> {
-      for (int i = 0; i <= n; ++i) {
-        co_await co_reschedule_on_current_executor;
-        co_yield i;
-      }
