-// http://graphics.stanford.edu/~seander/bithacks.html#RoundUpPowerOf2
-uint32_t roundUpToNextPowerOfTwo(uint32_t num) {
-  if (num == 0) {
-    return 0;
-  }
-  num--;
-  num |= num >> 1;
-  num |= num >> 2;
-  num |= num >> 4;
-  num |= num >> 8;
-  num |= num >> 16;
-  return num + 1;
-}
-
-#define X(c) \
-  case c:    \
-    return #c
