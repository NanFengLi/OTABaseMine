-typedef uint32_t Flags;
-
-// each method has 3 options: normal, noexcept, throw, and deleted
-// normal is the default
-// throw is mutually exclusive with noexcept
-//
-// DC - default constructor
-// CC - copy constructor
-// MC - move constructor
-// OC - other constructor
-// CA - copy assignment
-// MA - move assignment
-enum FlagVals : Flags {
-  DC_NOEXCEPT = 0x1,
-  DC_THROW = 0x2,
-  DC_DELETE = 0x8000,
-  CC_NOEXCEPT = 0x4,
-  CC_THROW = 0x8,
-  CC_DELETE = 0x10000,
-  MC_NOEXCEPT = 0x10,
-  MC_THROW = 0x20,
-  MC_DELETE = 0x20000,
-  OC_NOEXCEPT = 0x40,
-  OC_THROW = 0x80,
-  // OC_DELETE - DNE
-
-  CA_NOEXCEPT = 0x100,
-  CA_THROW = 0x200,
-  CA_DELETE = 0x40000,
-  MA_NOEXCEPT = 0x400,
-  MA_THROW = 0x800,
-  MA_DELETE = 0x80000,
-
-  ALL_DELETE = DC_DELETE | CC_DELETE | MC_DELETE | CA_DELETE | MA_DELETE,
-
-  IS_RELOCATABLE = 0x2000,
-
-  // for the allocator
-  PROP_COPY = 0x100000,
-  PROP_MOVE = 0x200000,
-  PROP_SWAP = 0x400000,
-};
