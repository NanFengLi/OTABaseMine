-    class Container = std::vector<
-        std::pair<Key, Value>,
-        folly::detail::std_pmr::polymorphic_allocator<std::pair<Key, Value>>>>
-using heap_vector_map = folly::heap_vector_map<
-    Key,
-    Value,
-    Compare,
-    folly::detail::std_pmr::polymorphic_allocator<std::pair<Key, Value>>,
-    GrowthPolicy,
-    Container>;
-
-} // namespace pmr
-
