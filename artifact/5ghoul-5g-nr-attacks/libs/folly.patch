-    class R = typename std::enable_if<
-        !std::is_same<T, U>::value,
-        typename std::common_type<T, U>::type>::type>
-R operator|(Optional<T>&& opt, const UnwrapOr<U>& fallback) {
-  if (T* p = opt.get_pointer()) {
-    return std::move(*p);
