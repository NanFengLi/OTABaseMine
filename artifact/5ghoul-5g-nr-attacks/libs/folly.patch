-ThreadWheelTimekeeperHighRes::~ThreadWheelTimekeeperHighRes() {
-  eventBase_.runInEventBaseThreadAndWait([this] {
-    wheelTimer_->cancelAll();
-    eventBase_.terminateLoopSoon();
-  });
-  thread_.join();
